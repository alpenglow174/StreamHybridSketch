{
  "uid": "fedsketch",
  "title": "Federated Sketches - live streaming analytics",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rounds released",
      "datasource": {
        "type": "influxdb",
        "uid": "fedsketch-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "fedsketch-influx"
          },
          "rawQuery": true,
          "query": "SELECT last(\"round\")+1 FROM \"server\" WHERE $timeFilter",
          "resultFormat": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
