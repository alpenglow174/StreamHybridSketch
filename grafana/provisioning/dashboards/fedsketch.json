    {
      "id": 10,
      "type": "timeseries",
      "title": "Top-50 F1 vs sliding-window truth (7 rounds)",
      "datasource": {
        "type": "influxdb",
        "uid": "fedsketch-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "fedsketch-influx"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"f1_win\") FROM \"quality\" WHERE $timeFilter GROUP BY time($__interval), \"variant\" fill(none)",
          "alias": "$tag_variant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "always",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
